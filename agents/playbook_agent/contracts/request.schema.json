{
  "type": "object",
  "required": [
    "contract_version",
    "correlation_id",
    "source_system",
    "playbook_name",
    "requested_action",
    "case",
    "observables",
    "dry_run"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "correlation_id": { "type": "string" },
    "source_system": { "type": "string", "enum": ["google_secops_soar"] },
    "playbook_name": { "type": "string" },
    "requested_action": {
      "type": "string",
      "enum": ["triage_suspicious_login"]
    },
    "case": {
      "type": "object",
      "required": ["case_id"],
      "properties": {
        "case_id": { "type": "string" },
        "alert_id": { "type": "string" },
        "severity": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "enum": ["user", "ip", "url", "host", "email"] },
          "value": { "type": "string" }
        }
      }
    },
    "dry_run": { "type": "boolean" }
  },
  "additionalProperties": false
}
